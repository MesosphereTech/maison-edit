# Browser endpoint only. Keep all credentials on a server.
VITE_GUIDE_ENDPOINT=
# Optional example server configuration; no values are supplied.
GEMINI_API_KEY=
GEMINI_MODEL=
GUIDE_ALLOWED_ORIGIN=
PORT=8080
# Optional owner-only cloud-workspace CLI test (not a hosted Sites backend).
# Requires a usable existing authorized login in a writable CLI runtime.
# Do not put CLI auth or tokens in this file, source, frontend, or deployment.
MAISON_AI_PROVIDER=
CODEX_CLI_TEST_ENABLED=false
# Optional public review safeguards; counters reset when the process restarts.
# These limits are not a durable daily quota or a financial spending cap.
PUBLIC_REVIEW_MODE=false
PUBLIC_REVIEW_REQUESTS_PER_MINUTE=12
PUBLIC_REVIEW_REQUESTS_PER_DAY=200
PUBLIC_REVIEW_MAX_CONCURRENT=2
